# =========================================================================
# RideGuardian AI - Environment Variables Configuration Template
# Copy this file to '.env' in the root directory and fill in your keys.
# =========================================================================

# LLM Core API Keys (Required for Live Chat & Safety Narrative Generation)
# The system will auto-detect which key is available.
SAMBANOVA_API_KEY=your_sambanova_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key (For Live GPS directions routing & hospital nearby search)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeather API Key (For live weather conditions along route waypoints)
OPENWEATHER_API_KEY=your_openweather_api_key_here
# SMTP Email Configurations (For live distress email dispatching to contacts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password_here

DEMO_EMERGENCY_EMAIL=your_emergency_contact_email@gmail.com

